# Generate a standalone token with: openssl rand -hex 32
STANDALONE_API_KEY=
STANDALONE_EMAIL=photos@example.local
STANDALONE_PASSWORD=
STANDALONE_NAME=Photo Backup

# Leave empty for standalone storage. For the dev Immich stack, use
# http://host.docker.internal:2284; on a shared Compose network use
# http://immich-server:2283.
IMMICH_SERVER_URL=
IMMICH_API_KEY=

MAX_UPLOAD_BYTES=107374182400
PROXY_BIND_ADDRESS=127.0.0.1
PROXY_PORT=8090
